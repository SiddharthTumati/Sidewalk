# AI assistant: set ONE of GROQ_API_KEY (free, console.groq.com), OPENAI_API_KEY, or GEMINI_API_KEY.
# If several are set, the order is Groq, OpenAI, Gemini, unless AI_PROVIDER says otherwise.
# GROQ_MODEL / OPENAI_MODEL / GEMINI_MODEL are optional overrides.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=replace_with_a_valid_gemini_api_key
PORT=3001
# Set APP_URL to the public URL when deploying so verification links work.
APP_URL=http://localhost:3001
# Email: set BREVO_API_KEY to send through Brevo's HTTPS API (use this on Railway,
# which blocks SMTP on Hobby). Otherwise configure SMTP below. SMTP_FROM is used either way.
BREVO_API_KEY=
# Configure SMTP to send verification and petition milestone emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM=Sidewalk <your-email@example.com>
SQLITE_PATH=./sidewalk.sqlite
# Set to true when running behind a hosting proxy (Render, Railway, Fly, etc.).
TRUST_PROXY=
# Set NODE_ENV=production when deployed so session cookies are Secure.
NODE_ENV=development
ADMIN_TOKEN=replace_with_a_long_random_coordinator_token
# Optional: daily Sideassist caps that protect the free AI quota (defaults shown).
AI_DAILY_LIMIT=800
AI_DAILY_LIMIT_PER_USER=40
# Bot check (Cloudflare Turnstile) on sign-up, guest reports, and password reset.
# Create a free widget at dash.cloudflare.com -> Turnstile. Leave blank to turn off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Endorsements from accounts younger than this many hours are shown as "pending" and
# don't count toward the 10/50 thresholds yet. Set 0 for a live demo with fresh accounts.
ENDORSE_MIN_ACCOUNT_AGE_HOURS=24
# Optional tuning (defaults shown).
ENDORSE_BURST_LIMIT=5
FLAGS_TO_HIDE=3
SIGNUPS_PER_NETWORK_PER_DAY=10
# Extra words to block in reports and names, comma-separated.
BLOCKED_WORDS=
# Phone notifications: keys are created automatically and saved in the database.
# Only set these to reuse keys from another server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
